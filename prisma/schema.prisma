// イベント集約サイト - Prisma schema (PostgreSQL / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// イベントの種別。取り込み時に classify.ts がタイトル・タグから推定する。
enum EventKind {
  HACKATHON
  CONTEST
  INTERNSHIP
  MEETUP
  SEMINAR
  OTHER
}

enum EventFormat {
  ONLINE
  OFFLINE
  HYBRID
}

/// どこから取り込んだか。MANUAL は seed / 手動登録。
enum IngestSource {
  CONNPASS
  DOORKEEPER
  MYNAVI
  X
  MANUAL
}

model Event {
  id           String       @id @default(cuid())
  /// 冪等 upsert のキー。イベント告知ページの URL。
  url          String       @unique
  externalId   String?
  ingestSource IngestSource @default(MANUAL)

  title       String
  description String?
  imageUrl    String?

  kind   EventKind
  format EventFormat
  /// オンライン開催では null
  prefecture String?
  venue      String?

  startsAt DateTime
  endsAt   DateTime?
  /// 応募・参加登録の締切。無い場合は startsAt をカウントダウンに使う。
  applyDeadline DateTime?

  /// 主催者名は文字列で保持する（企業テーブルは持たない）
  organizer    String?
  organizerUrl String?
  /// 賞金・賞品。ハッカソン / ビジコンでの主要な判断材料。
  prize String?
  /// string[]
  tags Json @default("[]")

  capacity Int?
  accepted Int?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([applyDeadline])
  @@index([kind, startsAt])
}
