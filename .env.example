# Supabase (PostgreSQL) connection string
# 例: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── News 機能 ────────────────────────────────────────────────────────────────
# GNews API キー (https://gnews.io/ で無料登録)
GNEWS_API_KEY="your_gnews_api_key_here"

# Anthropic Claude API キー (任意: 設定するとAI要約が有効になる)
ANTHROPIC_API_KEY=""

# Vercel Cron 保護シークレット (任意: 未設定なら開発時は認証なし)
CRON_SECRET=""

# ─── サイト全体のパスワード保護 (HTTP Basic認証) ──────────────────────────────
# SITE_AUTH_PASSWORD を設定すると全ページにBasic認証がかかる (未設定なら認証なし)
# SITE_AUTH_USER は空のままでOK (ブラウザのID入力欄は空でよい)
SITE_AUTH_USER=""
SITE_AUTH_PASSWORD=""
