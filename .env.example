# ------------------------------------------------------------------
# ローカル開発（next dev / wrangler dev）用の値は .dev.vars に書きます。
# 本番（Cloudflare Workers）は wrangler secret put で登録します。
#   例: npx wrangler secret put OPENAI_API_KEY
# 非機密の設定値は wrangler.jsonc の vars に置いています。
# ------------------------------------------------------------------
# このファイルは .dev.vars のひな形です。
#   Copy-Item .env.example .dev.vars

# X投稿のAI要約を使う場合だけ設定します。
OPENAI_API_KEY=""

# X APIは必要になった時だけ有効化します。トークンは絶対にGitや画面へ保存しません。
X_API_ENABLED="false"
X_API_BEARER_TOKEN=""
X_API_DAILY_POST_LIMIT="20"
X_API_MONTHLY_BUDGET_USD="5"
X_API_KEYWORDS="インターン,採用,募集,説明会,イベント,エントリー"

# Google連携（Gmail / Google Calendar）の公式OAuth設定。
# Google Cloud Consoleで「Web application」のOAuthクライアントを作り、
# Gmail API と Google Calendar API を有効にしてから値を入れます。
# 承認済みリダイレクトURI:
#   ローカル  http://localhost:3000/api/google/callback
#   本番      https://<あなたのWorker>.workers.dev/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/callback"
# 32バイトのランダム値をbase64または64桁の16進数で設定します。トークン暗号化にだけ使います。
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# DATABASE_URL は不要です。データベースは Cloudflare D1（wrangler.jsonc の d1_databases）です。
# prisma/seed.ts など Node から直接 SQLite を触るスクリプトを動かす時だけ設定します。
# DATABASE_URL="file:./dev.db"
