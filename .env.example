# ─── データベース (Neon PostgreSQL) ──────────────────────────────────────────
# DATABASE_URL: アプリから使う pooled 接続 (-pooler 付きのホスト)
# DIRECT_URL:   prisma migrate が使う直接接続
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DATABASE?sslmode=require"

# ─── イベント取り込み ─────────────────────────────────────────────────────────
# connpass API v2 のキー。申請・審査制（個人・コミュニティは無償）
# https://help.connpass.com/api/ から利用申請する。
# 未設定の場合 connpass コネクタは自動でスキップされる。
CONNPASS_API_KEY=""

# Vercel Cron 保護シークレット。/api/cron/ingest の Bearer 認証に使う。
CRON_SECRET=""

# ─── サイト設定 ──────────────────────────────────────────────────────────────
# OGP の絶対URL生成に使う。例: https://event-radar.vercel.app
NEXT_PUBLIC_SITE_URL=""

# ─── 管理画面 (/admin) ───────────────────────────────────────────────────────
# マイナビ・X などで見つけたイベントを手動登録する画面の Basic 認証。
# ADMIN_PASSWORD が未設定の場合 /admin と /api/admin は 404 になり機能ごと無効化される。
# ADMIN_USER は空のままでOK (ブラウザのID入力欄は空でよい)
ADMIN_USER=""
ADMIN_PASSWORD=""

# ─── サイト全体のパスワード保護 (HTTP Basic認証) ──────────────────────────────
# ステージング用。本番（一般公開）では未設定のままにする。
# SITE_AUTH_PASSWORD を設定すると全ページにBasic認証がかかる。
SITE_AUTH_USER=""
SITE_AUTH_PASSWORD=""
