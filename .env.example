# Google OAuth（Gmail / Google Calendar 連携）
# Google Cloud Console で OAuth 2.0 クライアントを作成して設定します。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ─── 外部連携 ────────────────────────────────────────────────────────────────
# GNews API キー（https://gnews.io/ で無料登録）
GNEWS_API_KEY=""

# 任意: 設定すると AI 要約が有効になります。
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Vercel Cron の保護シークレット（任意。未設定なら開発時は認証なし）
CRON_SECRET=""

# デモ表示用のユーザー ID（任意）
NEXT_PUBLIC_DEMO_USER_ID=""
