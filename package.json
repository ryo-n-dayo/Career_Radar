{
  "name": "daily-news-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:sources": "tsx scripts/scan-sources.ts",
    "schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-task.ps1",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-startup-task.ps1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "postinstall": "prisma generate",
    "prisma:reset": "prisma migrate reset",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 migrations apply dailynews --local",
    "d1:migrate:remote": "wrangler d1 migrations apply dailynews --remote",
    "d1:export": "tsx scripts/export-d1-seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/eslintrc": "^2.1.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.131.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
